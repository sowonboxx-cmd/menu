// Emails et SMS des réservations via Brevo. Voir workers/resa-notify.js.
// Servi sur resa.beltab.app. Rappels : tâche planifiée toutes les heures (à :05).
// Secrets à créer dans Cloudflare (jamais dans ce fichier) :
//   BREVO_API_KEY, SUPABASE_SERVICE_KEY, ADMIN_EMAIL (email qui reçoit les alertes quota)
// Commande de déploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.resa-notify.jsonc
{
  "name": "resa-notify",
  "compatibility_date": "2026-10-01",
  "main": "./workers/resa-notify.js",
  "routes": [{ "pattern": "resa.beltab.app", "custom_domain": true }],
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://fdbzzkzfipzabryfanun.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_9PaqDuXnWV3aOCBPk9ImmQ_4YgYTU9n",
    "SENDER_EMAIL": "reservation@beltab.app",
    "ALLOWED_ORIGINS": "*.workers.dev,https://sowonboxx-cmd.github.io,https://drevicioyster.com,https://www.drevicioyster.com,*.beltab.app"
  }
}
