// beltab.com : la carte des restaurants indépendants (beltab.fr et www.beltab.com redirigent vers beltab.com)
// Déploiement : npx wrangler deploy --config wrangler.beltab-fr.jsonc
{
  "name": "beltab-fr",
  "compatibility_date": "2026-10-01",
  "main": "beltab-fr/worker.js",
  "build": { "command": "node beltab-fr/build.mjs" },
  "assets": { "directory": "./beltab-fr/dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "beltab.com", "custom_domain": true },
    { "pattern": "www.beltab.com", "custom_domain": true },
    { "pattern": "beltab.fr", "custom_domain": true },
    { "pattern": "www.beltab.fr", "custom_domain": true }
  ]
}
