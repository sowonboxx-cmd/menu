// Deploiement Cloudflare de Drevici Oyster (production).
// Publie UNIQUEMENT le dossier drevici/, a la racine du domaine.
// Sans ce fichier, wrangler devine le dossier tout seul et prend le
// premier qui contient un index.html (c'etait baguette/).
// Commande de deploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.drevici.jsonc
{
  "name": "drevici",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./drevici" }
}
