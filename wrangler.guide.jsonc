// Deploiement Cloudflare de la page agence (offres + grille tarifaire).
// Publie UNIQUEMENT le dossier guide/, a la racine du domaine :
//   /           -> guide/index.html  (page des offres)
//   /tarif      -> guide/tarif.html  (grille, lit tarif.md a cote)
//   /story      -> guide/story.html
//   /drevici    -> guide/drevici/index.html (lien libre pour les associés, noindex)
// Commande de deploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.guide.jsonc
{
  "name": "guide",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./guide" },
  // Pages à partager en lien libre (non référencées) : partage.beltab.app/<client>, fabriquées par tools/partage.py
  "workers_dev": true,
  "routes": [{ "pattern": "partage.beltab.app", "custom_domain": true }]
}
