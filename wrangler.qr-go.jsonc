// Redirection des QR codes traçables : go.beltab.app/<CODE> → destination du code.
// Voir workers/qr-go.js et sql/qr.sql.
// Commande de déploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.qr-go.jsonc
{
  "name": "qr-go",
  "compatibility_date": "2026-10-01",
  "main": "./workers/qr-go.js",
  "routes": [{ "pattern": "go.beltab.app", "custom_domain": true }],
  "vars": {
    "SUPABASE_URL": "https://fdbzzkzfipzabryfanun.supabase.co",
    "SUPABASE_KEY": "sb_publishable_9PaqDuXnWV3aOCBPk9ImmQ_4YgYTU9n",
    "FALLBACK_URL": "https://drevici.beltab.app/"
  }
}
