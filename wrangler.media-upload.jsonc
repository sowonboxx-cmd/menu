// Envoi d'images depuis /gestion vers R2 (beltab-media → media.beltab.app).
// Voir workers/media-upload.js. Servi sur upload.beltab.app.
// Commande de déploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.media-upload.jsonc
{
  "name": "media-upload",
  "compatibility_date": "2026-10-01",
  "main": "./workers/media-upload.js",
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "beltab-media" }],
  "routes": [{ "pattern": "upload.beltab.app", "custom_domain": true }],
  "vars": {
    "SUPABASE_URL": "https://fdbzzkzfipzabryfanun.supabase.co",
    "SUPABASE_KEY": "sb_publishable_9PaqDuXnWV3aOCBPk9ImmQ_4YgYTU9n"
  }
}
