// Deploiement Cloudflare de Drevici Oyster SURZUR (copie de Paris, données propres « drevici-surzur »).
// Le dossier drevici-surzur/ est fabriqué par tools/publie-surzur.py (lancé par publie-drevici.py).
// Invisible pour Google tant que SITE_ENV vaut "hidden" : passer à "production" quand Surzur est prêt.
// Publie le dossier drevici/ + le Worker SEO/IA commun (workers/menu-seo.js) :
// titre, description, image de partage, donnees structurees, carte en texte pour
// les robots, robots.txt / sitemap.xml / llms.txt. Site indexe (SITE_ENV production).
// Commande de deploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.drevici-surzur.jsonc
{
  "name": "drevici-surzur",
  "compatibility_date": "2026-10-01",
  "main": "./workers/menu-seo.js",
  "assets": {
    "directory": "./drevici-surzur",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CLIENT_SLUG": "drevici-surzur",
    "SITE_ENV": "hidden",
    "CANONICAL_ORIGIN": "",
    "SUPABASE_URL": "https://fdbzzkzfipzabryfanun.supabase.co",
    "SUPABASE_KEY": "sb_publishable_9PaqDuXnWV3aOCBPk9ImmQ_4YgYTU9n",
    // Référencement préparé sur la recette (validé par Will le 12/10/2026). Publié le 12/10/2026.
    "SEO": {
      "name": "Drevici Oyster Surzur",
      "title": "Drevici Oyster · Dégustation au parc · Surzur, Morbihan",
      "description": "Dégustation d'huîtres en direct de notre parc à Surzur, dans le Morbihan. Producteurs-ostréiculteurs. Réservation en ligne.",
      "about": "Drevici Oyster, producteurs-ostréiculteurs à Surzur, dans le Morbihan : dégustation d'huîtres au parc, en direct du producteur.",
      "services": ["Réservation en ligne", "Dégustation d'huîtres au parc", "Vente directe"],
      "schemaType": ["Restaurant"],
      "cuisine": ["Huîtres", "Fruits de mer"],
      "priceRange": "15 € – 45 €",
      "image": "/seo/og-a1.jpg",
      "imageWidth": "1200",
      "imageHeight": "630",
      "imageAlt": "Ostréiculteurs Drevici au travail dans leur parc à huîtres de Surzur, aquarelle"
    }
    }
}
