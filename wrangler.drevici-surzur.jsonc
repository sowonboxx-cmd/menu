// Deploiement Cloudflare de Drevici Oyster SURZUR (copie de Paris, données propres « drevici-surzur »).
// Déploiement initial Surzur : 15/10/2026.
// Le dossier drevici-surzur/ est fabriqué par tools/publie-surzur.py (lancé par publie-drevici.py).
// Invisible pour Google tant que SITE_ENV vaut "hidden" : passer à "production" quand Surzur est prêt.
// Publie le dossier drevici/ + le Worker SEO/IA commun (workers/menu-seo.js) :
// titre, description, image de partage, donnees structurees, carte en texte pour
// les robots, robots.txt / sitemap.xml / llms.txt. Site indexe (SITE_ENV production).
// Commande de deploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.drevici-surzur.jsonc
{
  "name": "drevici-surzur",
  "compatibility_date": "2026-10-01",
  "main": "./workers/menu-seo.js",
  "assets": {
    "directory": "./drevici-surzur",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CLIENT_SLUG": "drevici-surzur",
    "SITE_ENV": "hidden",
    "CANONICAL_ORIGIN": "",
    "SUPABASE_URL": "https://fdbzzkzfipzabryfanun.supabase.co",
    "SUPABASE_KEY": "sb_publishable_9PaqDuXnWV3aOCBPk9ImmQ_4YgYTU9n",
    // Référencement propre à Surzur (rivière de Penerf, chantier de Pentès) — validé par Will le 16/10/2026.
    "SEO": {
      "name": "Drevici Oyster Surzur",
      "title": "Drevici Oyster Surzur · Huîtres de la rivière de Penerf",
      "description": "Dégustation d'huîtres au bord de la rivière de Penerf, sur notre chantier ostréicole à Surzur (Morbihan). Couchers de soleil, réservation en ligne.",
      "about": "Drevici Oyster, entreprise familiale d'ostréiculteurs à Surzur, dans le Morbihan. Nos huîtres, issues de captages naturels, grandissent sur la rivière de Penerf, une ria bretonne où l'eau douce du bassin versant se mêle à l'eau de mer. Affinées à faible densité dans des paniers suspendus, bercées par les marées et le courant : une coquille saine et une chair bien pleine. Notre espace de dégustation est adossé au chantier ostréicole, face à la rivière de Penerf : on y déguste nos huîtres en direct du producteur, à marée haute comme à marée basse, jusqu'au coucher du soleil.",
      "services": [
        "Réservation en ligne",
        "Dégustation d'huîtres au bord de la rivière de Penerf",
        "Vente directe au chantier ostréicole",
        "Huîtres en direct du producteur"
      ],
      "schemaType": [
        "Restaurant"
      ],
      "cuisine": [
        "Huîtres",
        "Fruits de mer"
      ],
      "priceRange": "15 € – 45 €",
      "image": "/seo/og-surzur-carte.jpg",
      "imageWidth": "1200",
      "imageHeight": "630",
      "imageAlt": "Plateau de dégustation au chantier de Surzur : huîtres, bulots et crevettes, face à la rivière de Penerf"
    }
  }
}
