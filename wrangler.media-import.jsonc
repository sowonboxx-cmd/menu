// Import ponctuel des médias Drevici vers R2 (beltab-media → media.beltab.app).
// Voir workers/media-import.js. Servi sur import.beltab.app : la conversion WebP
// (Cloudflare Images) ne marche que sur une zone où les Transformations sont activées.
// Commande de déploiement dans Cloudflare :
//   npx wrangler deploy --config wrangler.media-import.jsonc
// À supprimer une fois l'import terminé.
{
  "name": "media-import",
  "compatibility_date": "2026-10-01",
  "main": "./workers/media-import.js",
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "beltab-media" }],
  "routes": [{ "pattern": "import.beltab.app", "custom_domain": true }]
}
